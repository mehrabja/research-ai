APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

DATABASE_URL=postgresql+psycopg://research:CHANGE_ME@staging-db:5432/research

JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_BYTES_LONG

CORS_ALLOWED_ORIGINS=https://staging.example.com
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=staging-api.example.com
TRUSTED_PROXIES=10.0.0.0/8

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_ENQUEUE_PER_MINUTE=120

MAX_REQUEST_BYTES=10485760
METRICS_ENABLED=true
TRACING_ENABLED=false

FILE_STORAGE_BACKEND=s3
FILE_STORAGE_S3_BUCKET=CHANGE_ME
FILE_STORAGE_S3_REGION=CHANGE_ME
FILE_STORAGE_S3_ACCESS_KEY_ID=CHANGE_ME
FILE_STORAGE_S3_SECRET_ACCESS_KEY=CHANGE_ME
FILE_STORAGE_S3_ENDPOINT_URL=

BACKUP_DIRECTORY=/var/lib/research-ai/backups
BACKUP_RETENTION_DAYS=14
# --- Production external integrations (placeholders only) ---------
EMAIL_PROVIDER=smtp
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_SENDER=CHANGE_ME
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

FRONTEND_BASE_URL=https://app.example.com

PROVIDER_GENERATION_CHAIN=openai
PROVIDER_EMBEDDING_CHAIN=openai
PROVIDER_TRANSLATION_CHAIN=openai
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-4o-mini
GENERATION_OPENAI_BASE_URL=https://api.openai.com/v1
GENERATION_OPENAI_API_KEY=CHANGE_ME
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_OPENAI_API_KEY=CHANGE_ME
TRANSLATION_PROVIDER=openai
TRANSLATION_MODEL=gpt-4o-mini

STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_SUCCESS_URL=https://app.example.com/usage-billing?billing=success
STRIPE_CANCEL_URL=https://app.example.com/usage-billing?billing=cancel
STRIPE_PRICE_MAP_JSON={"pro":"price_CHANGE_ME","team":"price_CHANGE_ME"}

GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/auth/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=CHANGE_ME
GITHUB_OAUTH_CLIENT_SECRET=CHANGE_ME
GITHUB_OAUTH_REDIRECT_URI=https://app.example.com/api/auth/oauth/github/callback
