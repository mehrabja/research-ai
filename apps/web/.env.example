# Base URL of the FastAPI backend that the Next.js BFF proxy (app/api/[...path])
# forwards every /api/* request to. Server-side only — never exposed to the browser.
BACKEND_URL=http://localhost:8000

# Used only by `npm run generate:api` to fetch the live OpenAPI schema and
# regenerate lib/api/schema.d.ts. Not read at runtime.
BACKEND_OPENAPI_URL=http://localhost:8000/openapi.json
