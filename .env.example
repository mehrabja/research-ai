# ---------------------------------------------------------------------
# research-ai — environment template.
#
# Copy to `.env` at the monorepo root:
#     copy .env.example .env
#
# NEVER commit the resulting `.env`.
# Only placeholders belong in this file.
# ---------------------------------------------------------------------

# --- Application ----------------------------------------------------
APP_ENV=development
DEBUG=true
PROJECT_NAME=research-ai
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Provider routing (M39) ------------------------------------------
# Format: capability=provider1,provider2;capability2=provider1
PROVIDER_FALLBACKS=generation=openai,openrouter;embedding=openai,openrouter;translation=openai,openrouter;detection=http,heuristic;source_discovery=semantic_scholar,openalex,crossref

# --- Database -------------------------------------------------------
# Matches docker-compose.dev.yml defaults.
DATABASE_URL=postgresql+psycopg://research_ai:change_me@localhost:5432/research_ai
TEST_DATABASE_URL=
ALEMBIC_DATABASE_URL=

# --- DB pool (M36) --------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30.0
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# --- Auth -----------------------------------------------------------
JWT_SECRET_KEY=dev-insecure-secret-change-me-before-production
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_EMAIL_VERIFICATION_EXPIRE_HOURS=24
AUTH_MAX_SESSIONS=10

# --- HTTP / Security (M36) ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-API-Key
CORS_EXPOSED_HEADERS=X-Request-ID

TRUSTED_HOSTS=*
TRUSTED_PROXIES=

REQUEST_ID_HEADER=X-Request-ID
REQUEST_ID_ACCEPT_INCOMING=true

MAX_REQUEST_BYTES=10485760

# --- Rate limiting (M36) --------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_ENQUEUE_PER_MINUTE=120

# --- Readiness / shutdown -------------------------------------------
READINESS_TIMEOUT_SECONDS=3.0
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30.0

# --- Observability --------------------------------------------------
METRICS_ENABLED=true
TRACING_ENABLED=false

# --- Secrets --------------------------------------------------------
SECRET_BACKEND=env

# --- Storage --------------------------------------------------------
# Development default. Production can use the S3-compatible provider.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_ROOT=storage/files
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_PATH_STYLE=true

# --- Backup ---------------------------------------------------------
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14

# --- Provider credentials (NEVER commit real values) ----------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DETECTION_API_BASE_URL=
DETECTION_API_MODEL=ai-detector-v1
EMBEDDING_OPENAI_API_KEY=
GENERATION_OPENAI_API_KEY=

# Academic discovery
SOURCE_DISCOVERY_PROVIDER=semantic_scholar
SOURCE_DISCOVERY_FALLBACKS=openalex,crossref
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=
NCBI_API_KEY=
UNPAYWALL_EMAIL=
# Transactional email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_PROVIDER=none

# Billing
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_IDS=
STRIPE_SUCCESS_URL=http://localhost:3000/settings/billing?success=1
STRIPE_CANCEL_URL=http://localhost:3000/settings/billing?canceled=1
STRIPE_API_BASE_URL=https://api.stripe.com/v1

# OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=

# Detection
AI_DETECTION_API_KEY=

# Optional telemetry / abuse protection
SENTRY_DSN=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
AUTH_MFA_ISSUER=research-ai
AUTH_MFA_REQUIRED=false

# --- Web ------------------------------------------------------------
WEB_APP_BASE_URL=http://localhost:3000
