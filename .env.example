# ---------------------------------------------------------------------
# research-ai — environment template.
#
# Copy to `.env` at the monorepo root:
#     copy .env.example .env
#
# NEVER commit the resulting `.env`.
# Only placeholders belong in this file.
# ---------------------------------------------------------------------

# --- Application ----------------------------------------------------
APP_ENV=development
DEBUG=true
PROJECT_NAME=research-ai
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Database -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://research_ai:change_me@localhost:5432/research_ai
TEST_DATABASE_URL=postgresql+psycopg://research_ai:change_me@localhost:5432/research_ai
ALEMBIC_DATABASE_URL=postgresql+psycopg://research_ai:change_me@localhost:5432/research_ai

# --- DB pool (M36) --------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30.0
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# --- Auth -----------------------------------------------------------
JWT_SECRET_KEY=dev-insecure-secret-change-me-before-production

# --- HTTP / Security (M36) ------------------------------------------
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-CSRF-Token
CORS_EXPOSED_HEADERS=X-Request-ID

TRUSTED_HOSTS=*
TRUSTED_PROXIES=

REQUEST_ID_HEADER=X-Request-ID
REQUEST_ID_ACCEPT_INCOMING=true

MAX_REQUEST_BYTES=10485760

# --- Rate limiting (M36) --------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=600
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_ENQUEUE_PER_MINUTE=120

# --- Readiness / shutdown -------------------------------------------
READINESS_TIMEOUT_SECONDS=3.0
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30.0

# --- Observability --------------------------------------------------
METRICS_ENABLED=true
TRACING_ENABLED=false

# --- Secrets --------------------------------------------------------
SECRET_BACKEND=env

# --- Storage --------------------------------------------------------
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_ROOT=storage/files

# --- Backup ---------------------------------------------------------
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=14

# --- M39 provider routing -----------------------------------------
PROVIDER_GENERATION_CHAIN=openrouter
PROVIDER_EMBEDDING_CHAIN=openrouter
PROVIDER_TRANSLATION_CHAIN=openrouter

GENERATION_PROVIDER=openrouter
GENERATION_MODEL=openai/gpt-4o-mini
GENERATION_OPENAI_BASE_URL=
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_OPENAI_BASE_URL=
TRANSLATION_PROVIDER=openrouter
TRANSLATION_MODEL=openai/gpt-4o-mini

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Research AI

# Legacy direct-OpenAI adapter settings are retained for compatibility only;
# production defaults route through OpenRouter.
EMBEDDING_OPENAI_API_KEY=
GENERATION_OPENAI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Optional PubMed discovery adapter (NCBI E-utilities).
# Select SOURCE_SEARCH_PROVIDER=pubmed to use PubMed instead of Semantic Scholar.
SOURCE_SEARCH_PROVIDER=semantic_scholar
PUBMED_API_KEY=
PUBMED_EMAIL=
PUBMED_TOOL=research_ai
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_TIMEOUT_SECONDS=15
PUBMED_MAX_RETRIES=2
PUBMED_MIN_INTERVAL_SECONDS=0.34

# Optional OpenAlex Works API connector.
# A free key increases the daily budget; bounded searches work without a key.
# Set SOURCE_SEARCH_PROVIDER=openalex to select OpenAlex instead of the default provider.
OPENALEX_API_KEY=
OPENALEX_TIMEOUT_SECONDS=15
OPENALEX_MAX_RETRIES=2
OPENALEX_MIN_INTERVAL_SECONDS=0.15

# Optional arXiv preprint metadata connector (official Atom API; no API key).
# Set SOURCE_SEARCH_PROVIDER=arxiv to use arXiv instead of the default provider.
# arXiv recommends at least a 3-second delay between consecutive API requests.
ARXIV_TIMEOUT_SECONDS=20
ARXIV_MAX_RETRIES=2
ARXIV_MIN_INTERVAL_SECONDS=3.0

# Optional Crossref Works metadata connector.
# Set SOURCE_SEARCH_PROVIDER=crossref to use Crossref instead of Semantic Scholar.
# Supply a working mailto address for the polite pool; public queries default to 1 req/s.
CROSSREF_MAILTO=
CROSSREF_API_KEY=
CROSSREF_TIMEOUT_SECONDS=15
CROSSREF_MAX_RETRIES=2
CROSSREF_MIN_INTERVAL_SECONDS=1.0

# Europe PMC metadata/abstract discovery (no API key required).
# Abstract text is retained only for explicitly reusable CC BY/CC BY-SA/CC0/public-domain licences.
# Set SOURCE_SEARCH_PROVIDER=europepmc to select this provider.
EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest/search
EUROPEPMC_TIMEOUT_SECONDS=15
EUROPEPMC_MAX_RETRIES=2
EUROPEPMC_MIN_INTERVAL_SECONDS=0.34

# --- MCP (M42) -------------------------------------------------------
# Deployment-owned profiles: API clients can select profile keys only.
# Replace this illustrative hostname with a reviewed public HTTPS endpoint.
# MCP_SERVER_PROFILES_JSON={"kegg":{"display_name":"KEGG MCP","description":"KEGG connector","endpoint_url":"https://mcp.example.org/mcp","allowed_hosts":["mcp.example.org"],"auth_secret_ref":"MCP_KEGG_TOKEN"}}
MCP_SERVER_PROFILES_JSON=
# Secret values are supplied through deployment secret injection/SecretResolver.
MCP_KEGG_TOKEN=

# --- Email / OAuth / Stripe are configured only for staging/production.

