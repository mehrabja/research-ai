APP_ENV=development

POSTGRES_DB=research_ai
POSTGRES_USER=research_ai
POSTGRES_PASSWORD=research_ai_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://research_ai:research_ai_dev_password@localhost:5432/research_ai
# ---------- JWT ----------
JWT_SECRET_KEY=dev-insecure-secret-change-me-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=research-ai
JWT_AUDIENCE=research-ai-api
JWT_TYPE=access+jwt
JWT_CLOCK_SKEW_SECONDS=30

# ---------- Login throttling ----------
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300